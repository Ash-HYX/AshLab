---
import PageHeader from "@components/PageHeader.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getTagList } from "@utils/content-utils";

const tags = await getTagList();
---

<MainGridLayout title="标签">
	<PageHeader title="标签" description="从关键词进入相关内容" icon="material-symbols:tag-rounded" />
	<div class="card-base p-6 md:p-8 mb-4 flex flex-wrap gap-3 onload-animation">
		{tags.map((tag) => (
			<a href={`/tags/${encodeURIComponent(tag.name)}/`} class="btn-regular rounded-lg px-3 h-10 gap-2 active:scale-95">
				<span>#{tag.name}</span><span class="text-xs opacity-60">{tag.count}</span>
			</a>
		))}
	</div>
</MainGridLayout>
