---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
---

<MainGridLayout title="页面不存在">
	<section class="card-base px-6 py-16 md:py-24 mb-4 text-center onload-animation">
		<div class="mx-auto w-16 h-16 rounded-2xl bg-[var(--btn-regular-bg)] flex items-center justify-center text-[var(--primary)]">
			<Icon name="material-symbols:explore-off-outline-rounded" class="text-4xl" />
		</div>
		<p class="mt-6 text-sm font-bold text-[var(--primary)]">404</p>
		<h1 class="mt-2 text-3xl font-bold text-90">页面不存在</h1>
		<p class="mt-3 text-50">链接可能已经失效，或者内容尚未发布。</p>
		<a href="/" class="btn-regular inline-flex rounded-lg h-11 px-5 mt-7 gap-2 font-bold active:scale-95">
			<Icon name="material-symbols:home-outline-rounded" class="text-xl" />返回首页
		</a>
	</section>
</MainGridLayout>
