---
import PageHeader from "@components/PageHeader.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { timeline } from "@/data/site";
---

<MainGridLayout title="时间线">
	<PageHeader title="时间线" description="学习、生活与网站的重要节点" icon="material-symbols:timeline" />
	<div class="card-base px-6 md:px-8 py-7 mb-4 onload-animation">
		<ol class="relative border-l border-[var(--line-color)] ml-3">
			{timeline.map((item) => (
				<li class="relative pl-7 pb-9 last:pb-0">
					<span class="absolute -left-[7px] top-1 w-3 h-3 rounded-full bg-[var(--primary)] ring-4 ring-[var(--card-bg)]"></span>
					<time class="text-sm text-30">{item.date}</time>
					<h2 class="mt-1 text-lg font-bold text-90">{item.title}</h2>
					<p class="mt-2 text-50 leading-7">{item.description}</p>
				</li>
			))}
		</ol>
	</div>
</MainGridLayout>
