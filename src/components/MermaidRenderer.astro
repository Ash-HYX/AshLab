<script is:inline type="module">
async function renderMermaidBlocks() {
	const blocks = [...document.querySelectorAll('pre[data-language="mermaid"], pre:has(code.language-mermaid)')];
	if (blocks.length === 0) return;
	try {
		const { default: mermaid } = await import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs');
		mermaid.initialize({ startOnLoad: false, theme: document.documentElement.classList.contains('dark') ? 'dark' : 'default', securityLevel: 'strict' });
		for (const [index, block] of blocks.entries()) {
			if (!(block instanceof HTMLElement) || block.dataset.mermaidRendered === 'true') continue;
			const code = block.querySelector('code')?.textContent || block.textContent || '';
			const container = document.createElement('div');
			container.className = 'mermaid-diagram my-6 overflow-x-auto rounded-xl bg-[var(--btn-regular-bg)] p-4';
			const id = `mermaid-${Date.now()}-${index}`;
			const { svg } = await mermaid.render(id, code.trim());
			container.innerHTML = svg;
			block.replaceWith(container);
			container.dataset.mermaidRendered = 'true';
		}
	} catch (error) {
		console.warn('Mermaid rendering failed; keeping source code visible.', error);
	}
}

renderMermaidBlocks();
document.addEventListener('swup:contentReplaced', renderMermaidBlocks);
</script>
